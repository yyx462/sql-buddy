# Copy to .env (gitignored). Never commit real tokens.
#
# Pi 0.84+ China Coding Plan:
#   AFK_PROVIDER=zai-coding-cn
#   ZAI_API_KEY or ZAI_CODING_CN_API_KEY
#   Do NOT put "apiKey": "ZAI_API_KEY" in models.json (literal token bug).

AFK_AGENT=pi
AFK_PROVIDER=zai-coding-cn
AFK_MODEL=glm-4.7
# AFK_THINKING=medium

ZAI_API_KEY=replace-with-your-coding-plan-key

# Gitea (host wrapper — never inject into sandbox)
# Prefer file on Jenkins: AFK_GITEA_TOKEN_FILE=/data/www/algo/deps/gitea-token-afk
# AFK_GITEA_TOKEN=
AFK_GITEA_URL=https://git.sh.nint.com
AFK_REPO=ying.yuxiang/sql-buddy
AFK_BASE_BRANCH=master
AFK_LABEL=ready-for-agent
AFK_IN_PROGRESS_LABEL=afk:in-progress
AFK_TEA_LOGIN=sql-buddy-afk

# Sandbox
# AFK_SANDBOX=docker
# AFK_SANDBOX=none
AFK_DOCKER_IMAGE=sql-buddy-afk:pi
# Optional read-only example ini (no secrets)
# AFK_READONLY_INI=/path/to/db.ini.example

# Issue selection
# AFK_ISSUE=1
# AFK_MAX_ITERATIONS=8
# AFK_DRY_RUN=1
# AFK_CWD=   # defaults to repo root (parent of afk/)
