// sql-buddy sync pipeline — Jenkins job "sql-buddy-sync" (cicd.nint.hk)
//
// Trigger: Gitea "pull request" webhook filtered to action=closed and
// pull_request.merged=true. After a human clicks Merge in the Gitea UI,
// this job fast-forwards the shared workspace (/data/www/algo/sql-buddy-review)
// to origin/master so the next SSH login finds a clean checkout — no more
// `git pull && git reset --hard` ritual on every login.
//
// Strictly read-only against the workspace: fetch + reset --hard + clean.
// No build, no deploy, no push, no merge. Smart cascades belong in their
// own pipelines so a sync failure doesn't block unrelated work.
//
// Secrets: reuses $GITEA_TOKEN_FILE (same file as the review pipeline).
// The token's read scope is enough for fetch; write scope is unused here.
//
// One-time job setup (UI):
//   1. New Item → Pipeline; Definition = "Pipeline script from SCM"; same
//      repo URL / 'sea' credential / branch master as the review job;
//      Script path "Jenkinsfile.sync"; Node restriction = agent{label'web01'}.
//   2. Save + run once manually so Jenkins registers the triggers{} block.
//   3. Add a second Gitea webhook (or reuse the existing one — the token
//      field disambiguates) for "Pull requests" with URL
//      https://cicd.nint.hk/generic-webhook-trigger/invoke?token=sql-buddy-sync
//      content-type application/json, trigger = Pull requests.

pipeline {
    agent {
        node {
            label 'web01'
            customWorkspace '/data/www/algo/sql-buddy-sync'
        }
    }

    options {
        disableConcurrentBuilds()                          // 1 sync at a time
        buildDiscarder(logRotator(numToKeepStr: '50'))
        timeout(time: 5, unit: 'MINUTES')
        timestamps()
    }

    environment {
        GITEA_URL         = 'https://git.sh.nint.com'
        MAINTAINER        = 'ying.yuxiang'
        GITEA_TOKEN_FILE  = '/data/www/algo/deps/gitea-token'
        // The workspace this pipeline fast-forwards. NOT customWorkspace:
        // the sync pipeline's own @tmp-parent dir is /data/www/algo/sql-buddy-sync;
        // the operand (the review pipeline's checkout that humans SSH into)
        // is a separate path. Sharing customWorkspace with the review pipeline
        // would race concurrent review+sync builds, with sync's reset --hard /
        // clean -fd wiping review's in-progress pr.diff / verdict.json.
        REVIEW_WORKSPACE  = '/data/www/algo/sql-buddy-review'
    }

    triggers {
        GenericTrigger(
            token: 'sql-buddy-sync',
            causeString: 'PR #$PR_NUMBER merged, syncing workspace',
            genericVariables: [
                [key: 'ACTION',    value: '$.action'],
                [key: 'PR_NUMBER', value: '$.number'],
                [key: 'DRAFT',     value: '$.pull_request.draft'],
                [key: 'AUTHOR',    value: '$.pull_request.user.login'],
                [key: 'MERGED',    value: '$.pull_request.merged'],
                [key: 'REPO_FULL', value: '$.repository.full_name'],
            ],
            // `closed` fires for both merge and close-without-merge; the
            // shell stage filters further on $MERGED.
            regexpFilterText: '$ACTION',
            regexpFilterExpression: '^closed$',
            printContributedVariables: false,
            printPostContent: false,
        )
    }

    stages {

        stage('Skip check') {
            steps {
                sh '''
                set -e
                if [ -z "${PR_NUMBER:-}" ]; then
                    echo "manual build (no PR payload) -> skip"
                    exit 0
                fi
                if [ "$MERGED" != "true" ]; then
                    echo "skip: PR closed without merge"
                    exit 0
                fi
                # NOTE: unlike the review pipeline, the sync pipeline does NOT
                # skip on $AUTHOR == $MAINTAINER. The maintainer authors most
                # PRs and merges them in the UI; the workspace should
                # fast-forward to origin/master either way — otherwise the
                # next SSH login hits the divergent-branches prompt. The review
                # pipeline keeps the maintainer skip (self-review is sensible);
                # the two pipelines deliberately differ on this rule.
                if [ "$DRAFT" = "true" ]; then
                    echo "skip: draft PR"
                    exit 0
                fi
                # Check for skip-review label to match the review pipeline's contract.
                { set +x; } 2>/dev/null
                export GITEA_TOKEN="$(cat "$GITEA_TOKEN_FILE" 2>/dev/null || true)"
                LABELS=$(curl -sf \
                    -H "Authorization: token $GITEA_TOKEN" \
                    "$GITEA_URL/api/v1/repos/$REPO_FULL/issues/$PR_NUMBER/labels" \
                    2>/dev/null || echo '[]')
                { set -x; } 2>/dev/null
                if echo "$LABELS" | grep -q '"skip-review"'; then
                    echo "skip: PR has skip-review label"
                    exit 0
                fi
                echo "proceed: syncing workspace after merge of PR #$PR_NUMBER by $AUTHOR"
                '''
            }
        }

        stage('Sync workspace') {
            steps {
                sh '''
                set -e
                { set +x; } 2>/dev/null
                export GITEA_TOKEN="$(cat "$GITEA_TOKEN_FILE")"
                REPO_URL="https://x-access-token:${GITEA_TOKEN}@git.sh.nint.com/ying.yuxiang/sql-buddy.git"
                { set -x; } 2>/dev/null

                # Operate on the REVIEW_WORKSPACE, NOT the sync pipeline's own
                # customWorkspace. The two Jenkins items have independent
                # @tmp-parent dirs to avoid concurrent-build races.
                cd "$REVIEW_WORKSPACE"

                if [ ! -d .git ]; then
                    git clone "$REPO_URL" .
                fi
                # Retry up to 3 times in case Gitea's merge commit is not yet
                # replicated to all backends when the webhook fires.
                ok=0
                for attempt in 1 2 3; do
                    if git fetch origin master 2>/tmp/fetch.err; then
                        ok=1
                        break
                    fi
                    echo "fetch attempt $attempt failed; retrying in 5s"
                    sleep 5
                done
                if [ "$ok" != 1 ]; then
                    echo "fetch failed after 3 attempts:" >&2
                    cat /tmp/fetch.err >&2
                    exit 1
                fi
                # The workspace is a throwaway checkout, not a dev tree —
                # reset --hard is safe here. Anything you edited by hand
                # in this dir is gone, that's the contract.
                git checkout -B master origin/master
                git reset --hard origin/master
                git clean -fd
                git log --oneline -1
                '''
            }
        }
    }
}